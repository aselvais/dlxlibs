\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid Generic logger class for Deluxe on the EDP\par
\par
Args:\par
    app_name (str, optional): Application/logger name. Defaults to "".\par
    format (str, optional): csv | json | default - Log format see FORMATTERS. Defaults to "json".\par
    log_ext (str, optional): Log file extension. Defaults to "log".\par
    handlers (str, optional): Handlers to setup. k=Kafka, f=file, c=console. Defaults to "kfc".\par
    source_system_name (str, optional): Name of the source system or app. Defaults to "logs".\par
    schema_name (str, optional): Schema name. Defaults to "logs".\par
    table_name (str, optional): Table name. Defaults to "logs".\par
    env (str, optional): Environment, dev | prod. Defaults to "dev".\par
\par
 Usage:\par
    my_logger = DlxLogger().get_logger()\par
    my_logger.debug("a debug message")\par
\par
other example:\par
    my_logger = DlxLogger("", "csv", "csv").get_logger()\par
    my_logger.debug("THIS IS IT ! a debug message", \{command: "INSERT", storagename: "logs__logs__testtable", count: 20\})\par
\par
This will create a CSV formatted file with a .csv extension\par
}
 \par
}}
